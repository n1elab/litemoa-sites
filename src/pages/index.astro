---
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialEmbeds from '../components/SocialEmbeds.astro';
import ParticipationNote from '../components/ParticipationNote.astro';
import ConnectionInfo from '../components/ConnectionInfo.astro';
import ServerStatus from '../components/ServerStatus.astro';
import { getCollection } from 'astro:content';
const news = (await getCollection('news')).filter(entry => !entry.data.draft).sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()).slice(0,3);
const formatDate = (date: Date) => new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo' }).format(date);
---
<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-layout">
      <div>
        <p class="eyebrow">Java版・統合版で遊べる生活経済サーバー</p>
        <h1 id="hero-title" class="hero-heading">ここで、<br />暮らしていこう。</h1>
        <p class="hero-lead">お店で売り買いする。家や街をつくる。顔なじみと話す。リテ鯖が目指すのは、経済を通じて人とつながり、自分の居場所をつくれる生活鯖です。</p>
        <div class="hero-actions"><a class="primary-button" href="/wiki/join/">リテ鯖への参加方法</a><a class="secondary-link" href="/wiki/rules/">利用規約</a></div>
      </div>
      <div class="hero-board">
        <ParticipationNote />
        <ConnectionInfo compact />
        <ServerStatus />
      </div>
    </div>
  </section>
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="shell">
      <div class="about-layout">
        <h2 id="about-title">商売も、採掘も、<br />ここで過ごす毎日の一部。</h2>
        <p>採ってきたものをお店に並べる。誰かのお店で、建築に使う材料を買う。作業の合間に立ち話をする。そんな日々を重ねて、「ここで暮らしていたい」と思える場所を、鯖民と運営でつくっていきます。</p>
      </div>
      <div class="feature-grid" id="features">
        <article class="feature-card"><h3>商店街に、自分の店を。</h3><p>チェストショップでアイテムを売り買い。建物も品ぞろえも、自分で考えてつくれます。</p></article>
        <article class="feature-card"><h3>自分の拠点で、サバイバル。</h3><p>建築、採掘、探索、農業。土地保護を使いながら、自分のペースで暮らせます。</p></article>
      </div>
    </div>
  </section>
  <section class="section news-home" id="news" aria-labelledby="news-title">
    <div class="shell"><h2 id="news-title">お知らせ</h2>
      <div class="news-list">
        {news.length ? news.map(item => <a class="news-row" href={`/news/${item.id}/`}><time datetime={item.data.publishedAt.toISOString()}>{formatDate(item.data.publishedAt)}</time><span class="news-category">{item.data.category}</span><strong>{item.data.title}</strong><span class="news-arrow" aria-hidden="true">→</span></a>) : <p class="news-empty">現在公開中のお知らせはありません。</p>}
      </div>
      <div class="news-more"><a href="/news/">お知らせ一覧 →</a></div>
    </div>
  </section>
  <section class="section" aria-labelledby="guide-title"><div class="shell"><h2 id="guide-title">遊ぶ前に</h2><nav class="guide-links" aria-label="参加とルール"><a href="/wiki/join/">Java版・統合版の参加方法 →</a><a href="/wiki/rules/">利用規約 →</a><a href="/wiki/">ガイドの入口 →</a></nav></div></section>
  <SocialEmbeds />
</SiteLayout>
