---
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialEmbeds from '../components/SocialEmbeds.astro';
import { getCollection } from 'astro:content';

const news = (await getCollection('news'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
---

<SiteLayout>
  <section class="hero">
    <div class="hero-grid"></div>

    <div class="shell hero-inner">
      <img
        class="hero-server-icon"
        src="/server-icon.png"
        alt="Litemoa Server アイコン"
        width="96"
        height="96"
      />

      <div class="server-status" data-server-status aria-live="polite">
        <span class="status-dot"></span>
        <span data-status-text>サーバー情報を取得中…</span>
      </div>

      <p class="eyebrow">LITEMOA SERVER / CROSS-PLAY LIFE ECONOMY</p>
      <p class="hero-concept">もう一つの日常を、マイクラの世界で。</p>
      <h1>Litemoa Server<span>リテ鯖</span></h1>
      <p class="hero-lead">
        Minecraft本来のサバイバルを楽しみながら、お店を開いたり、街を作ったり、
        鯖民同士で雑談したり。Java版・統合版から一緒に遊べる生活経済サーバーです。
      </p>

      <div class="hero-actions">
        <a class="primary-button" href="/wiki/join/">参加方法を見る</a>

        <button
          class="secondary-button"
          type="button"
          data-copy-ip
          data-ip="liteplay.n1e.net"
        >
          <span>liteplay.n1e.net</span>
          <strong data-copy-label>IPをコピー</strong>
        </button>
      </div>

      <p class="hero-note">Java版 / 統合版対応 · PC / スマホ / タブレット / ゲーム機</p>
    </div>
  </section>

  <section class="section" id="about">
    <div class="shell section-heading">
      <div>
        <p class="section-label">ABOUT</p>
        <h2>ログインしたら、<br />いつもの誰かがいる。</h2>
      </div>

      <p>
        Litemoaが目指しているのは、効率だけを追いかける場所ではなく、
        サバイバルを土台にそれぞれの暮らしや関係が少しずつ育っていく世界です。
        一人でのんびり遊ぶ日も、誰かと話しながら遊ぶ日も歓迎です。
      </p>
    </div>

    <div class="shell about-panel">
      <p>
        建築や冒険を楽しんだり、商店街に自分のお店を作ったり、
        プレイヤー同士でアイテムを売買したり、Discordで雑談したり。
        運営が用意した遊び方をなぞるだけではなく、鯖民それぞれの活動が
        サーバーの景色や経済を作っていく。そんな「もう一つの日常」を目指しています。
      </p>
    </div>
  </section>

  <section class="section" id="features">
    <div class="shell section-heading compact">
      <div>
        <p class="section-label">FEATURES</p>
        <h2>リテ鯖でできること。</h2>
      </div>
    </div>

    <div class="shell feature-grid">
      <article class="feature-card">
        <span class="feature-number">01</span>
        <div class="feature-symbol" aria-hidden="true">⛏</div>
        <h3>サバイバルが土台</h3>
        <p>Minecraft本来の資源集め、冒険、建築を大切に。便利さを足しても、サバイバルそのものの面白さは残します。</p>
      </article>

      <article class="feature-card">
        <span class="feature-number">02</span>
        <div class="feature-symbol" aria-hidden="true">¥</div>
        <h3>鯖民がつくる経済</h3>
        <p>経済の中心はプレイヤー同士の売買。自分のお店や取引を通して、サーバーの経済に参加できます。</p>
      </article>

      <article class="feature-card">
        <span class="feature-number">03</span>
        <div class="feature-symbol" aria-hidden="true">店</div>
        <h3>自由なお店づくり</h3>
        <p>商店街でチェストショップを開いたり、ゲーム内の仕組みを使った遊びやサービスを考えたり。アイデアを形にできます。</p>
      </article>

      <article class="feature-card">
        <span class="feature-number">04</span>
        <div class="feature-symbol" aria-hidden="true">↔</div>
        <h3>クロスプレイ</h3>
        <p>Java版と統合版のプレイヤーが、同じ世界で一緒に遊べる環境を目指しています。</p>
      </article>

      <article class="feature-card">
        <span class="feature-number">05</span>
        <div class="feature-symbol" aria-hidden="true">◎</div>
        <h3>運営も同じ世界に</h3>
        <p>運営も鯖民と近い距離でサバイバルを楽しみながら、みんなと一緒に世界を育てていく方針です。</p>
      </article>

      <article class="feature-card">
        <span class="feature-number">06</span>
        <div class="feature-symbol" aria-hidden="true">#</div>
        <h3>まったりコミュニティ</h3>
        <p>建築を見せ合ったり、Discordで雑談したり。毎日来ても、久しぶりに帰ってきても居やすい場所を目指します。</p>
      </article>
    </div>
  </section>

  <section class="section news-home" id="news">
    <div class="shell section-heading">
      <div>
        <p class="section-label">NEWS</p>
        <h2>リテ鯖からのお知らせ。</h2>
      </div>

      <p>
        サイト更新、メンテナンス、イベントなどの情報を掲載します。
      </p>
    </div>

    <div class="shell news-list">
      {news.length > 0 ? (
        news.map((item) => (
          <a class="news-row" href={`/news/${item.id}/`}>
            <time datetime={item.data.publishedAt.toISOString()}>
              {formatDate(item.data.publishedAt)}
            </time>
            <span class="news-category">{item.data.category}</span>
            <strong>{item.data.title}</strong>
            <span class="news-arrow" aria-hidden="true">→</span>
          </a>
        ))
      ) : (
        <div class="news-empty">現在公開中のお知らせはありません。</div>
      )}
    </div>

    <div class="shell news-more">
      <a href="/news/">NEWS一覧を見る →</a>
    </div>
  </section>

  <section class="wiki-promo">
    <div class="shell wiki-promo-inner">
      <div>
        <p class="section-label">OFFICIAL WIKI</p>
        <h2>公式wiki</h2>
        <p>
          参加方法、ワールドの情報、コマンドの使用方法などを Wiki にまとめています。
        </p>
      </div>

      <div class="wiki-links">
        <a href="/wiki/">Wikiトップ <span>→</span></a>
        <a href="/wiki/join/">参加方法 <span>→</span></a>
        <a href="/wiki/rules/">利用規約 <span>→</span></a>
      </div>
    </div>
  </section>

  <SocialEmbeds />

  <section class="join-cta">
    <div class="shell join-cta-inner">
      <p class="section-label">READY?</p>
      <h2>もう一つの日常へ。</h2>
      <p>まずはWikiで参加方法と利用規約を確認して、気軽に遊びに来てください。</p>

      <div class="hero-actions center">
        <a class="primary-button" href="/wiki/join/">参加方法を見る</a>
        <a
          class="secondary-link"
          href="https://discord.gg/UyKV4BDxBR"
          target="_blank"
          rel="noopener noreferrer"
        >Discordに参加 ↗</a>
      </div>
    </div>
  </section>

  <script>
    const statusRoot = document.querySelector('[data-server-status]');
    const statusText = document.querySelector('[data-status-text]');

    async function updateServerStatus() {
      try {
        const response = await fetch('https://api.mcstatus.io/v2/status/java/liteplay.n1e.net');
        if (!response.ok) throw new Error('status api error');

        const data = await response.json();

        if (data.online) {
          statusRoot?.classList.add('online');

          if (statusText) {
            statusText.textContent =
              `ONLINE · ${data.players.online} / ${data.players.max} PLAYERS`;
          }
        } else if (statusText) {
          statusText.textContent = 'OFFLINE';
        }
      } catch {
        if (statusText) {
          statusText.textContent = 'STATUS UNAVAILABLE';
        }
      }
    }

    updateServerStatus();

    document.querySelector('[data-copy-ip]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;

      if (!(button instanceof HTMLElement)) return;

      const ip = button.dataset.ip || 'liteplay.n1e.net';
      const label = button.querySelector('[data-copy-label]');

      try {
        await navigator.clipboard.writeText(ip);

        if (label) label.textContent = 'コピーしました';

        window.setTimeout(() => {
          if (label) label.textContent = 'IPをコピー';
        }, 1600);
      } catch {
        if (label) label.textContent = ip;
      }
    });
  </script>
</SiteLayout>
