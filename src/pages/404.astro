---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="404 Not Found"
  description="ページが見つかりませんでした。公式サイトまたはWikiから目的の情報を探せます。"
>
  <section class="error-page">
    <div class="shell error-inner">
      <img
        class="error-icon"
        src="/server-icon.png"
        alt=""
        width="84"
        height="84"
        aria-hidden="true"
      />

      <span>404 / NOT FOUND</span>
      <h1 data-error-title>ページが見つかりません</h1>

      <p data-error-message>
        URLが変更されたか、ページが削除された可能性があります。
      </p>

      <div class="error-choice-grid">
        <a class="error-choice official-choice" href="/">
          <small>OFFICIAL SITE</small>
          <strong>公式サイトへ</strong>
          <span>サーバー情報・NEWS・Discordを見る →</span>
        </a>

        <a class="error-choice wiki-choice" href="/wiki/">
          <small>OFFICIAL WIKI</small>
          <strong>Wikiへ</strong>
          <span>参加方法・ルールを探す →</span>
        </a>
      </div>

      <div class="error-shortcuts">
        <a href="/news/">NEWS</a>
        <a href="/wiki/join/">参加方法</a>
        <a href="/wiki/rules/">利用規約</a>
        <a href="https://litemoamap.n1e.net/">ウェブマップ ↗</a>
      </div>
    </div>
  </section>

  <script>
    const path = window.location.pathname;
    const title = document.querySelector('[data-error-title]');
    const message = document.querySelector('[data-error-message]');
    const wikiCard = document.querySelector('.wiki-choice');
    const officialCard = document.querySelector('.official-choice');

    if (path.startsWith('/wiki/')) {
      document.body.classList.add('error-from-wiki');
      wikiCard?.classList.add('recommended');

      if (title) title.textContent = 'Wikiのページが見つかりません';
      if (message) {
        message.textContent =
          'ページ名が変更されたか、Wikiの記事がまだ作成されていない可能性があります。';
      }
    } else {
      officialCard?.classList.add('recommended');
    }
  </script>
</SiteLayout>
