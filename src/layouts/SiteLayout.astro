---
import '../styles/tokens.css';
import '../styles/shared.css';
import '../styles/site.css';
import Brand from '../components/Brand.astro';
import SiteLinks from '../components/SiteLinks.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeProvider from '../components/ThemeProvider.astro';
import ThemeSelect from '../components/ThemeSelect.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; ogType?: 'website' | 'article'; publishedAt?: Date; updatedAt?: Date; noindex?: boolean; }
const { title = 'Litemoa Server（リテ鯖）', description = '経済を通じて人とつながり、自分の居場所をつくれる生活鯖を目指すリテ鯖。お店での売買、家や街づくり、日々の会話をJava版・統合版で楽しむMinecraftサーバーです。', ogType = 'website', publishedAt, updatedAt, noindex = false } = Astro.props;
const pageTitle = title === 'Litemoa Server（リテ鯖）' ? title : `${title} | Litemoa Server（リテ鯖）`;
const canonical = new URL(Astro.url.pathname, site.origin).toString();
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@type': ogType === 'article' ? 'NewsArticle' : 'WebSite', name: pageTitle, headline: ogType === 'article' ? title : undefined, datePublished: publishedAt?.toISOString(), dateModified: updatedAt?.toISOString() ?? publishedAt?.toISOString(), url: canonical, image: `${site.origin}/og-image.png`, description, inLanguage: 'ja', publisher: { '@type': 'Organization', name: site.name, url: site.origin } }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <ThemeProvider />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/server-icon.png" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf9f5" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.origin}/og-image.png`} />
    <meta property="og:locale" content="ja_JP" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.origin}/og-image.png`} />
    {!noindex && <script type="application/ld+json" set:html={structuredData}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <div class="shell header-inner">
        <Brand />
        <nav class="desktop-nav" aria-label="サイトナビゲーション"><SiteLinks /></nav>
        <ThemeSelect />
        <details class="mobile-menu" data-mobile-menu>
          <summary>メニュー</summary>
          <nav aria-label="サイトナビゲーション"><SiteLinks /><a href="/wiki/rules/">利用規約</a><a href={site.discord}>Discord</a></nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>
      document.querySelectorAll<HTMLDetailsElement>('[data-mobile-menu]').forEach((menu) => {
        menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
        menu.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
      });
    </script>
  </body>
</html>
