---
import { site } from '../data/site';
import ConnectionInfo from './ConnectionInfo.astro';
import ParticipationNote from './ParticipationNote.astro';
---
<div class="game-wiki-portal">
  <ParticipationNote />
  <nav class="wiki-quick-grid" aria-label="ガイドの入口">
    <a class="wiki-quick-card" href="/wiki/join/"><strong>参加方法</strong><small>Java版・統合版の接続情報と手順</small></a>
    <a class="wiki-quick-card" href="/wiki/rules/"><strong>利用規約</strong><small>禁止行為とサーバーのルール</small></a>
    <a class="wiki-quick-card" href="/news/"><strong>お知らせ</strong><small>メンテナンス・公開情報</small></a>
    <a class="wiki-quick-card" href="/wiki/policy/"><strong>プライバシー</strong><small>データの取扱いと連絡先</small></a>
  </nav>
  <h2>接続情報</h2>
  <ConnectionInfo />
  <aside class="wiki-help-note"><strong>困ったときは</strong><p>ガイドで解決しないときは、<a href={site.discord}>Discord</a>で相談できます。</p></aside>
</div>
